+ */
+
+#include <math.h>
+#include <stdio.h>
+
+#include "filters/filter.h"
+#include "filters/filter_internal.h"
+#include "filters/user_filters.h"
+#include "options/m_option.h"
+#include "video/filter/nvidia_vfg.h"
+#include "video/mp_image.h"
+#include "video/mp_image_pool.h"
+#include "video/sws_utils.h"
+
+struct opts {
+    int mode;
+    int multiplier;
+};
+
+struct priv {
+    struct opts *opts;
+    struct mp_image_pool *pool;
+    struct mp_image_pool *download_pool;
+    struct mp_sws_context *sws;
+
+    struct mpv_nvidia_vfg *vfg;
+    int vfg_format;
+    int vfg_width;
+    int vfg_height;
+    bool disabled;
+    bool warned;
+    bool previous_uploaded;
+
+    struct mp_image *previous;
+    struct mp_image *next;
+    struct mp_image *ready[8];
+    int ready_count;
+    int ready_pos;
+    struct mp_frame pending_frame;
+    bool has_pending_frame;
+    bool eof_pending;
+};
+
+static int frame_format(const struct mp_image *image)
+{
+    // Match the D3D11 upload format to avoid converting every SDR output frame.
+    return pl_color_space_is_hdr(&image->params.color) ?
+           IMGFMT_X2BGR10 : IMGFMT_BGRA;
+}
+
+static enum mpv_nvidia_vfg_format bridge_format(int imgfmt)
+{
+    return imgfmt == IMGFMT_X2BGR10 ? MPV_NVIDIA_VFG_RGB10A2 :
+                                     MPV_NVIDIA_VFG_BGRA8;
+}
+
+static void clear_ready(struct priv *p)
+{
+    for (int n = 0; n < p->ready_count; n++)
+        mp_image_unrefp(&p->ready[n]);
+    p->ready_count = 0;
+    p->ready_pos = 0;
+}
+
+static void reset(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+    mp_image_unrefp(&p->previous);
+    mp_image_unrefp(&p->next);
+    clear_ready(p);
+    mp_frame_unref(&p->pending_frame);
+    p->pending_frame = (struct mp_frame){0};
+    p->has_pending_frame = false;
+    p->eof_pending = false;
+    p->previous_uploaded = false;
+}
+
+static void destroy(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+    reset(f);
+    mpv_nvidia_vfg_destroy(&p->vfg);
+}
+
+static void disable_vfg(struct mp_filter *f, struct priv *p, const char *error)
+{
+    if (!p->warned) {
+        MP_WARN(f, "%s; passing video through without frame generation.\n",
+                error ? error : "NVIDIA VFX SDK unavailable");
+        p->warned = true;
+    }
+    mpv_nvidia_vfg_destroy(&p->vfg);
+    p->disabled = true;
+}
+
+static bool ensure_vfg(struct mp_filter *f, struct priv *p,
+                       const struct mp_image *image, int imgfmt)
+{
+    if (p->vfg && p->vfg_width == image->w && p->vfg_height == image->h &&
+        p->vfg_format == imgfmt)
+        return true;
+
+    mpv_nvidia_vfg_destroy(&p->vfg);
+    p->previous_uploaded = false;
+    char error[256] = {0};
+    p->vfg = mpv_nvidia_vfg_create(image->w, image->h,
+                                   bridge_format(imgfmt), p->opts->mode,
+                                   p->opts->multiplier,
+                                   error, sizeof(error));
+    if (!p->vfg) {
+        disable_vfg(f, p, error);
+        return false;
+    }
+
+    p->vfg_width = image->w;
+    p->vfg_height = image->h;
+    p->vfg_format = imgfmt;
+    return true;
+}
+
+static struct mp_image *convert_frame(struct priv *p, struct mp_image *image,
+                                      int imgfmt)
+{
+    // VFG accepts both hardware-decoded and software-decoded input. Only
+    // hardware images need downloading; mp_image_hw_download() returns NULL
+    // for ordinary software frames.
+    struct mp_image *source = image;
+    if (image->hwctx) {
+        source = mp_image_hw_download(image, p->download_pool);
+        if (!source)
+            return NULL;
+    }
+
+    struct mp_image *converted;
+    if (source->imgfmt == imgfmt) {
+        converted = source == image ? mp_image_new_ref(source) : source;
+    } else {
+        converted = mp_image_pool_get(p->pool, imgfmt, source->w, source->h);
+        if (converted)
+            mp_image_copy_attributes(converted, source);
+    }
+    if (!converted) {
+        if (source != image)
+            talloc_free(source);
+        return NULL;
+    }
+
+    converted->params.repr.sys = PL_COLOR_SYSTEM_RGB;
+    converted->params.repr.levels = PL_COLOR_LEVELS_FULL;
+    converted->params.repr.alpha = PL_ALPHA_INDEPENDENT;
+    if (source->imgfmt != imgfmt && mp_sws_scale(p->sws, converted, source) < 0) {
+        talloc_free(converted);
+        if (source != image)
+            talloc_free(source);
+        return NULL;
+    }
+
+    if (source != image && source != converted)
+        talloc_free(source);
+    return converted;
+}
+
+static bool valid_timestamps(const struct mp_image *previous,
+                             const struct mp_image *current, double *delta)
+{
+    if (previous->pts == MP_NOPTS_VALUE || current->pts == MP_NOPTS_VALUE ||
+        !isfinite(previous->pts) || !isfinite(current->pts))
+        return false;
+
+    *delta = current->pts - previous->pts;
+    if (*delta <= 0)
+        return false;
+
+    if (previous->pkt_duration > 0 && *delta > previous->pkt_duration * 2.0)
+        return false;
+
+    return true;
+}
+
+static struct mp_image *make_generated(struct priv *p, unsigned int index,
+                                       double delta)
+{
+    const int fmt = p->previous->imgfmt;
+    struct mp_image *generated = mp_image_pool_get(p->pool, fmt, p->previous->w,
+                                                  p->previous->h);
+    if (!generated)
+        return NULL;
+
+    mp_image_copy_attributes(generated, p->previous);
+    generated->params.repr.sys = PL_COLOR_SYSTEM_RGB;
+    generated->params.repr.levels = PL_COLOR_LEVELS_FULL;
+    generated->params.repr.alpha = PL_ALPHA_INDEPENDENT;
+    generated->pts = p->previous->pts + delta * index / p->opts->multiplier;
+    generated->pkt_duration = delta / p->opts->multiplier;
+
+    char error[256] = {0};
+    if (!mpv_nvidia_vfg_run(p->vfg, index,
+                            generated->planes[0], generated->stride[0],
+                            error, sizeof(error))) {
+        talloc_free(generated);
+        return NULL;
+    }
+
+    return generated;
+}
+
+static bool generate_pair(struct mp_filter *f, struct priv *p)
+{
+    double delta;
+    if (!p->previous || !p->next)
+        return false;
+
+    if (p->previous->w != p->next->w || p->previous->h != p->next->h ||
+        p->previous->imgfmt != p->next->imgfmt) {
+        MP_VERBOSE(f, "Skipping VFG frame pair with mismatched formats or dimensions.\n");
+        return false;
+    }
+
+    if (!valid_timestamps(p->previous, p->next, &delta)) {
+        MP_VERBOSE(f, "Skipping VFG frame pair with invalid timestamps: %.6f -> %.6f (duration %.6f).\n",
+                   p->previous->pts, p->next->pts, p->previous->pkt_duration);
+        return false;
+    }
+
+    char error[256] = {0};
+    if (!mpv_nvidia_vfg_set_inputs(p->vfg,
+                                   p->previous->planes[0],
+                                   p->previous->stride[0],
+                                   p->next->planes[0],
+                                   p->next->stride[0],
+                                   p->previous_uploaded,
+                                   error, sizeof(error))) {
+        disable_vfg(f, p, error);
+        return false;
+    }
+
+    struct mp_image *previous = p->previous;
+    for (int i = 1; i < p->opts->multiplier; i++) {
+        struct mp_image *generated = make_generated(p, i, delta);
+        if (!generated) {
+            for (int n = 0; n < p->ready_count; n++)
+                mp_image_unrefp(&p->ready[n]);
+            p->ready_count = 0;
+            disable_vfg(f, p, "NVIDIA VFG failed for a frame pair");
+            return false;
+        }
+        p->ready[p->ready_count++] = generated;
+    }
+
+    MP_VERBOSE(f, "NVIDIA VFG generated %d intermediate frame(s) for input pair (%.6f -> %.6f).\n",
+               p->opts->multiplier - 1, p->previous->pts, p->next->pts);
+
+    memmove(&p->ready[1], &p->ready[0],
+            p->ready_count * sizeof(p->ready[0]));
+    p->ready[0] = previous;
+    p->ready_count++;
+    p->previous = NULL;
+    p->previous_uploaded = true;
+    return true;
+}
+
+static void pass_through_pair(struct priv *p)
+{
+    clear_ready(p);
+    p->ready_pos = 0;
+    p->ready_count = 0;
+    if (p->previous)
+        p->ready[p->ready_count++] = p->previous;
+    if (p->next)
+        p->ready[p->ready_count++] = p->next;
+    p->previous = NULL;
+    p->next = NULL;
+    p->previous_uploaded = false;
+}
+
+static void promote_next(struct priv *p)
+{
+    clear_ready(p);
+    p->previous = p->next;
+    p->next = NULL;
+    if (!p->previous)
+        p->previous_uploaded = false;
+}
+
+static void write_ready(struct mp_filter *f, struct priv *p)
+{
+    struct mp_image *image = p->ready[p->ready_pos];
+    p->ready[p->ready_pos++] = NULL;
+    if (p->ready_pos == p->ready_count)
+        promote_next(p);
+    mp_pin_in_write(f->ppins[1], MAKE_FRAME(MP_FRAME_VIDEO, image));
+}
+
+static void pass_through_buffered(struct mp_filter *f, struct priv *p,
+                                  struct mp_frame frame)
+{
+    if (!p->previous) {
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+
+    p->ready[0] = p->previous;
+    p->previous = NULL;
+    p->ready_count = 1;
+    p->ready_pos = 0;
+    p->pending_frame = frame;
+    p->has_pending_frame = true;
+    write_ready(f, p);
+}
+
+static void process(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+
+    if (!mp_pin_in_needs_data(f->ppins[1]))
+        return;
+
+    if (p->ready_pos < p->ready_count) {
+        write_ready(f, p);
+        return;
+    }
+
+    if (p->eof_pending) {
+        p->eof_pending = false;
+        mp_pin_in_write(f->ppins[1], MAKE_FRAME(MP_FRAME_EOF, NULL));
+        return;
+    }
+
+    if (p->has_pending_frame) {
+        struct mp_frame frame = p->pending_frame;
+        p->pending_frame = (struct mp_frame){0};
+        p->has_pending_frame = false;
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+
+    if (p->disabled) {
+        if (p->previous) {
+            struct mp_image *previous = p->previous;
+            p->previous = NULL;
+            mp_pin_in_write(f->ppins[1], MAKE_FRAME(MP_FRAME_VIDEO, previous));
+            return;
+        }
+        mp_pin_transfer_data(f->ppins[1], f->ppins[0]);
+        return;
+    }
+
+    if (!mp_pin_out_request_data(f->ppins[0]))
+        return;
+
+    struct mp_frame frame = mp_pin_out_read(f->ppins[0]);
+    if (frame.type == MP_FRAME_NONE)
+        return;
+
+    if (frame.type == MP_FRAME_EOF) {
+        p->eof_pending = true;
+        if (p->previous) {
+            p->ready[0] = p->previous;
+            p->previous = NULL;
+            p->ready_count = 1;
+            p->ready_pos = 0;
+            write_ready(f, p);
+            return;
+        }
+        process(f);
+        return;
+    }
+
+    if (frame.type != MP_FRAME_VIDEO) {
+        if (p->previous) {
+            p->ready[0] = p->previous;
+            p->previous = NULL;
+            p->ready_count = 1;
+            p->ready_pos = 0;
+            p->pending_frame = frame;
+            p->has_pending_frame = true;
+            write_ready(f, p);
+        } else {
+            mp_pin_in_write(f->ppins[1], frame);
+        }
+        return;
+    }
+
+    struct mp_image *image = frame.data;
+    int imgfmt = frame_format(image);
+    if (!ensure_vfg(f, p, image, imgfmt)) {
+        pass_through_buffered(f, p, frame);
+        return;
+    }
+
+    struct mp_image *converted = convert_frame(p, image, imgfmt);
+    if (!converted) {
+        disable_vfg(f, p, "Could not convert a frame to an NVIDIA VFG format");
+        pass_through_buffered(f, p, frame);
+        return;
+    }
+
+    mp_image_unrefp(&image);
+
+    if (!p->previous) {
+        p->previous = converted;
+        mp_pin_out_request_data(f->ppins[0]);
+        return;
+    }
+
+    p->next = converted;
+    if (!generate_pair(f, p))
+        pass_through_pair(p);
+
+    if (p->ready_count)
+        write_ready(f, p);
+}
+
+static const struct mp_filter_info filter = {
+    .name = "nvidia-vfg",
+    .process = process,
+    .reset = reset,
+    .destroy = destroy,
+    .priv_size = sizeof(struct priv),
+};
+
+static struct mp_filter *create(struct mp_filter *parent, void *options)
+{
+    struct mp_filter *f = mp_filter_create(parent, &filter);
+    if (!f) {
+        talloc_free(options);
+        return NULL;
+    }
+
+    mp_filter_add_pin(f, MP_PIN_IN, "in");
+    mp_filter_add_pin(f, MP_PIN_OUT, "out");
+
+    struct priv *p = f->priv;
+    p->opts = talloc_steal(p, options);
+    p->pool = mp_image_pool_new(p);
+    p->download_pool = mp_image_pool_new(p);
+    p->sws = mp_sws_alloc(p);
+    MP_HANDLE_OOM(p->pool);
+    MP_HANDLE_OOM(p->download_pool);
+    MP_HANDLE_OOM(p->sws);
+    return f;
+}
+
+#define OPT_BASE_STRUCT struct opts
