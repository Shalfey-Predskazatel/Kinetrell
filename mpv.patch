diff --git a/video/filter/nvidia_vfg.c b/video/filter/nvidia_vfg.c
new file mode 100644
index 0000000..cdeb3cc
--- /dev/null
+++ b/video/filter/nvidia_vfg.c
@@ -0,0 +1,547 @@
+/*
