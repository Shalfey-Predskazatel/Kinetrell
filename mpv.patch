+// Read a local file in full or fail when it exceeds the caller's limit.
+static int script_read_local_file(lua_State *L)
+{
+    const char *path = luaL_checkstring(L, 1);
+    lua_Integer limit = luaL_checkinteger(L, 2);
+    luaL_argcheck(L, limit > 0 && limit < INT_MAX, 2, "invalid file size limit");
+    struct script_ctx *ctx = get_ctx(L);
+    int flags = STREAM_READ_FILE_FLAGS_DEFAULT | STREAM_SILENT;
+    bstr data = stream_read_file2(path, NULL, flags, ctx->mpctx->global, limit);
+    if (!data.start) {
+        lua_pushnil(L);
+        return 1;
+    }
+    lua_pushlstring(L, data.start, data.len);
+    talloc_free(data.start);
+    return 1;
+}
+
+// Replace a local file with the payload using mpv's native path handling.
+static int script_atomic_write_file(lua_State *L)
+{
+    const char *path = luaL_checkstring(L, 1);
+    size_t size;
+    const char *payload = luaL_checklstring(L, 2, &size);
+    lua_pushboolean(L, mp_save_to_file(path, payload, size));
+    return 1;
+}
