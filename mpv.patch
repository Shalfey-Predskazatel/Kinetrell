+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <windows.h>
+
+#include "nvidia_vfg.h"
+#include "nvvfx/nvVideoEffects.h"
+
+// These formats were added to NvCVImage after the public 0.7.6 headers below.
+// The values are appended to the public enums to preserve the older ABI.
+#define MPV_NVCV_RGB10A2 ((NvCVImage_PixelFormat)13)
+#define MPV_NVCV_P32 ((NvCVImage_ComponentType)11)
+
+#define VFG_EFFECT "VideoFrameGeneration"
+#define VFG_MODE "VideoFrameGeneration.Mode"
+#define VFG_INPUT_WIDTH "InputWidth"
+#define VFG_INPUT_HEIGHT "InputHeight"
+#define VFG_MULTIPLIER "VideoFrameGeneration.FrameMultiplier"
+#define VFG_FRAME_INDEX "VideoFrameGeneration.FrameIndex"
+#define VFG_SHOT_CHANGE "VideoFrameGeneration.ShotChange"
+#define VFG_AUTO_SHOT_CHANGE "VideoFrameGeneration.AutomaticShotChangeDetectionEnabled"
+
+typedef NvCV_Status (*NvVFX_CreateEffect_fn)(NvVFX_EffectSelector, NvVFX_Handle *);
+typedef void (*NvVFX_DestroyEffect_fn)(NvVFX_Handle);
+typedef NvCV_Status (*NvVFX_SetU32_fn)(NvVFX_Handle, NvVFX_ParameterSelector,
+                                       unsigned int);
+typedef NvCV_Status (*NvVFX_SetCudaStream_fn)(NvVFX_Handle,
+                                               NvVFX_ParameterSelector,
+                                               CUstream);
+typedef NvCV_Status (*NvVFX_SetImage_fn)(NvVFX_Handle,
+                                         NvVFX_ParameterSelector, NvCVImage *);
+typedef NvCV_Status (*NvVFX_Run_fn)(NvVFX_Handle, int);
+typedef NvCV_Status (*NvVFX_Load_fn)(NvVFX_Handle);
+typedef NvCV_Status (*NvCVImage_Alloc_fn)(NvCVImage *, unsigned int,
+                                           unsigned int, NvCVImage_PixelFormat,
+                                           NvCVImage_ComponentType, unsigned int,
+                                           unsigned int, unsigned int);
+typedef NvCV_Status (*NvCVImage_Transfer_fn)(const NvCVImage *, NvCVImage *,
+                                              float, CUstream, NvCVImage *);
+typedef void (*NvCVImage_Dealloc_fn)(NvCVImage *);
+
+struct mpv_nvidia_vfg {
+    HMODULE vfx_dll;
+    HMODULE image_dll;
+
+    NvVFX_CreateEffect_fn create_effect;
+    NvVFX_DestroyEffect_fn destroy_effect;
+    NvVFX_SetU32_fn set_u32;
+    NvVFX_SetCudaStream_fn set_cuda_stream;
+    NvVFX_SetImage_fn set_image;
+    NvVFX_Run_fn run;
+    NvVFX_Load_fn load;
+    NvCVImage_Alloc_fn image_alloc;
+    NvCVImage_Transfer_fn image_transfer;
+    NvCVImage_Dealloc_fn image_dealloc;
+
+    NvVFX_Handle effect;
+    NvCVImage previous_host;
+    NvCVImage current_host;
+    NvCVImage inputs[2];
+    unsigned int current_slot;
+    NvCVImage output;
+
+    unsigned int width;
+    unsigned int height;
+    unsigned int multiplier;
+    enum mpv_nvidia_vfg_format format;
+};
+
+static void set_error(char *error, size_t error_size, const char *message)
+{
+    if (error && error_size)
+        snprintf(error, error_size, "%s", message);
+}
+
+static void set_status_error(char *error, size_t error_size,
+                             const char *operation, NvCV_Status status)
+{
+    if (error && error_size)
+        snprintf(error, error_size, "%s failed (NVIDIA VFX status %d)",
+                 operation, (int)status);
+}
+
+static bool append_path(char *dst, size_t dst_size, const char *directory,
+                        const char *filename)
+{
+    size_t length = strlen(directory);
+    const char *separator = length && directory[length - 1] != '\\' &&
+                            directory[length - 1] != '/' ? "\\" : "";
+    int written = snprintf(dst, dst_size, "%s%s%s", directory, separator,
+                           filename);
+    return written >= 0 && (size_t)written < dst_size;
+}
+
+static HMODULE load_library_from_directory(const char *directory,
+                                           const char *filename)
+{
+    char path[MAX_PATH] = {0};
+    if (!append_path(path, sizeof(path), directory, filename))
+        return NULL;
+
+    return LoadLibraryExA(path, NULL,
+                          LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR |
+                          LOAD_LIBRARY_SEARCH_DEFAULT_DIRS);
+}
+
+static void add_sdk_root(char roots[][MAX_PATH], int *count,
+                         const char *directory)
+{
+    if (!directory || !directory[0] || *count >= 8)
+        return;
+
+    for (int n = 0; n < *count; n++) {
+        if (_stricmp(roots[n], directory) == 0)
+            return;
+    }
+
+    snprintf(roots[*count], MAX_PATH, "%s", directory);
+    (*count)++;
+}
+
+static void add_process_search_directory(const char *directory)
+{
+    if (!directory || !directory[0])
+        return;
+
+    char path[32768] = {0};
+    DWORD length = GetEnvironmentVariableA("PATH", path, sizeof(path));
+    if (length >= sizeof(path))
+        return;
+
+    size_t directory_length = strlen(directory);
+    const char *current = path;
+    while (*current) {
+        const char *separator = strchr(current, ';');
+        size_t entry_length = separator ? (size_t)(separator - current) :
+                                          strlen(current);
+        if (entry_length == directory_length &&
+            _strnicmp(current, directory, directory_length) == 0)
+            return;
+        if (!separator)
+            break;
+        current = separator + 1;
+    }
+
+    size_t path_length = strlen(path);
+    size_t separator_length = path_length ? 1 : 0;
+    if (path_length + separator_length + directory_length >= sizeof(path))
+        return;
+
+    if (path_length)
+        path[path_length++] = ';';
+    memcpy(path + path_length, directory, directory_length + 1);
+    SetEnvironmentVariableA("PATH", path);
+}
+
+static HMODULE load_sdk_library(const char *filename)
+{
+    char roots[8][MAX_PATH] = {{0}};
+    int root_count = 0;
+    char directory[MAX_PATH] = {0};
+    DWORD length = GetEnvironmentVariableA("NV_VIDEO_EFFECTS_PATH", directory,
+                                          sizeof(directory));
+
+    if (length && length < sizeof(directory) && strcmp(directory, "USE_APP_PATH") == 0) {
+        length = GetModuleFileNameA(NULL, directory, sizeof(directory));
+        if (length && length < sizeof(directory)) {
+            char *slash = strrchr(directory, '\\');
+            char *forward_slash = strrchr(directory, '/');
+            if (forward_slash && (!slash || forward_slash > slash))
+                slash = forward_slash;
+            if (slash) {
+                *slash = '\0';
+                add_sdk_root(roots, &root_count, directory);
+            }
+        }
+    } else if (length && length < sizeof(directory)) {
+        add_sdk_root(roots, &root_count, directory);
+    }
+
+    length = GetEnvironmentVariableA("ProgramFiles", directory,
+                                     sizeof(directory));
+    if (length && length < sizeof(directory)) {
+        char sdk_directory[MAX_PATH];
+        if (append_path(sdk_directory, sizeof(sdk_directory), directory,
+                        "NVIDIA Corporation\\NVIDIA Video Effects"))
+            add_sdk_root(roots, &root_count, sdk_directory);
+    }
+
+    // NVIDIA's installer allows a custom directory. The portable package's
+    // installer uses this standard location on this Windows system, so direct
+    // launches of mpv.exe can discover the separately installed SDK too.
+    add_sdk_root(roots, &root_count, "D:\\NVIDIA\\VideoEffects\\VideoFX");
+    add_sdk_root(roots, &root_count, "D:\\NVIDIA\\VideoEffects");
+
+    length = GetEnvironmentVariableA("LOCALAPPDATA", directory,
+                                     sizeof(directory));
+    if (length && length < sizeof(directory)) {
+        char sdk_directory[MAX_PATH];
+        if (append_path(sdk_directory, sizeof(sdk_directory), directory,
+                        "NVIDIA\\VideoEffects"))
+            add_sdk_root(roots, &root_count, sdk_directory);
+    }
+
+    static const char *const subdirectories[] = {"lib", "bin", NULL};
+    for (int root = 0; root < root_count; root++) {
+        // Let the NVIDIA core find feature binaries and resources relative to
+        // whichever SDK installation actually supplied this DLL.
+        SetEnvironmentVariableA("NV_VIDEO_EFFECTS_PATH", roots[root]);
+        char sdk_bin[MAX_PATH] = {0};
+        if (append_path(sdk_bin, sizeof(sdk_bin), roots[root], "bin"))
+            add_process_search_directory(sdk_bin);
+        char feature_bin[MAX_PATH] = {0};
+        if (append_path(feature_bin, sizeof(feature_bin), roots[root],
+                        "features\\nvvfxvideoframegeneration\\bin"))
+            add_process_search_directory(feature_bin);
+
+        HMODULE module = load_library_from_directory(roots[root], filename);
+        if (module)
+            return module;
+
+        for (int n = 0; subdirectories[n]; n++) {
+            char subdirectory[MAX_PATH] = {0};
+            if (!append_path(subdirectory, sizeof(subdirectory), roots[root],
+                             subdirectories[n]))
+                continue;
+            module = load_library_from_directory(subdirectory, filename);
+            if (module)
+                return module;
+        }
+    }
+
+    return NULL;
+}
+
+static bool load_functions(struct mpv_nvidia_vfg *vfg)
+{
+    vfg->vfx_dll = load_sdk_library("NVVideoEffects.dll");
+    vfg->image_dll = load_sdk_library("NVCVImage.dll");
+    if (!vfg->vfx_dll || !vfg->image_dll)
+        return false;
+
+#define LOAD_VFX(field, module, symbol) do { \
+    FARPROC proc = GetProcAddress(vfg->module, symbol); \
+    if (!proc) return false; \
+    memcpy(&vfg->field, &proc, sizeof(vfg->field)); \
+    } while (0)
+    LOAD_VFX(create_effect, vfx_dll, "NvVFX_CreateEffect");
+    LOAD_VFX(destroy_effect, vfx_dll, "NvVFX_DestroyEffect");
+    LOAD_VFX(set_u32, vfx_dll, "NvVFX_SetU32");
+    LOAD_VFX(set_cuda_stream, vfx_dll, "NvVFX_SetCudaStream");
+    LOAD_VFX(set_image, vfx_dll, "NvVFX_SetImage");
+    LOAD_VFX(run, vfx_dll, "NvVFX_Run");
+    LOAD_VFX(load, vfx_dll, "NvVFX_Load");
+    LOAD_VFX(image_alloc, image_dll, "NvCVImage_Alloc");
+    LOAD_VFX(image_transfer, image_dll, "NvCVImage_Transfer");
+    LOAD_VFX(image_dealloc, image_dll, "NvCVImage_Dealloc");
+#undef LOAD_VFX
+    return true;
+}
+
+static bool set_u32_candidates(struct mpv_nvidia_vfg *vfg,
+                               const char *const *selectors,
+                               unsigned int value,
+                               char *error, size_t error_size)
+{
+    NvCV_Status status = NVCV_ERR_SELECTOR;
+    for (int n = 0; selectors[n]; n++) {
+        status = vfg->set_u32(vfg->effect, selectors[n], value);
+        if (status == NVCV_SUCCESS)
+            return true;
+    }
+    set_status_error(error, error_size, selectors[0], status);
+    return false;
+}
+
+static bool alloc_image(struct mpv_nvidia_vfg *vfg, NvCVImage *image,
+                        unsigned int memory_space,
+                        char *error, size_t error_size)
+{
+    NvCVImage_PixelFormat format = vfg->format == MPV_NVIDIA_VFG_BGRA8 ?
+                                   NVCV_BGRA : MPV_NVCV_RGB10A2;
+    NvCVImage_ComponentType component = vfg->format == MPV_NVIDIA_VFG_BGRA8 ?
+                                        NVCV_U8 : MPV_NVCV_P32;
+    NvCV_Status status = vfg->image_alloc(image, vfg->width, vfg->height,
+                                          format, component, NVCV_CHUNKY,
+                                          memory_space, 32);
+    if (status == NVCV_SUCCESS)
+        return true;
+    set_status_error(error, error_size, "NvCVImage_Alloc", status);
+    return false;
+}
+
+static void copy_pixels(uint8_t *restrict destination,
+                        const uint8_t *restrict source, unsigned int width,
+                        uint32_t keep, uint32_t set)
+{
+    for (unsigned int x = 0; x < width; x++) {
+        uint32_t pixel;
+        memcpy(&pixel, source + x * sizeof(pixel), sizeof(pixel));
+        pixel = (pixel & keep) | set;
+        memcpy(destination + x * sizeof(pixel), &pixel, sizeof(pixel));
+    }
+}
+
+static void copy_to_pinned(struct mpv_nvidia_vfg *vfg, NvCVImage *destination,
+                           const uint8_t *source, int source_stride)
+{
+    // Set opaque alpha while copying either BGRA or mpv's X2BGR10.
+    uint32_t alpha = vfg->format == MPV_NVIDIA_VFG_RGB10A2
+        ? 0xC0000000u : 0xFF000000u;
+    for (ptrdiff_t y = 0; y < vfg->height; y++) {
+        uint8_t *dst = (uint8_t *)destination->pixels + y * destination->pitch;
+        const uint8_t *src = source + y * source_stride;
+        copy_pixels(dst, src, vfg->width, UINT32_MAX, alpha);
+    }
+}
+
+static void copy_from_pinned(struct mpv_nvidia_vfg *vfg, uint8_t *destination,
+                             int destination_stride)
+{
+    // Return opaque BGRA, or strip the alpha bits for mpv's X2BGR10.
+    bool rgb10 = vfg->format == MPV_NVIDIA_VFG_RGB10A2;
+    uint32_t keep = rgb10 ? 0x3FFFFFFFu : UINT32_MAX;
+    uint32_t set = rgb10 ? 0 : 0xFF000000u;
+    for (ptrdiff_t y = 0; y < vfg->height; y++) {
+        uint8_t *dst = destination + y * destination_stride;
+        const uint8_t *src = (const uint8_t *)vfg->output.pixels +
+                             y * vfg->output.pitch;
+        copy_pixels(dst, src, vfg->width, keep, set);
+    }
+}
+
+struct mpv_nvidia_vfg *mpv_nvidia_vfg_create(unsigned int width,
+                                             unsigned int height,
+                                             enum mpv_nvidia_vfg_format format,
+                                             unsigned int mode,
+                                             unsigned int multiplier,
+                                             char *error, size_t error_size)
+{
+    struct mpv_nvidia_vfg *vfg = calloc(1, sizeof(*vfg));
+    if (!vfg) {
+        set_error(error, error_size, "Out of memory creating NVIDIA VFG");
+        return NULL;
+    }
+
+    vfg->width = width;
+    vfg->height = height;
+    vfg->format = format;
+    vfg->multiplier = multiplier;
+    if (!load_functions(vfg)) {
+        set_error(error, error_size,
+                  "NVIDIA VFX SDK runtime was not found; install the SDK Core and VFG feature");
+        goto fail;
+    }
+
+    NvCV_Status status = vfg->create_effect(VFG_EFFECT, &vfg->effect);
+    if (status != NVCV_SUCCESS) {
+        set_status_error(error, error_size, "NvVFX_CreateEffect", status);
+        goto fail;
+    }
+
+    if (!alloc_image(vfg, &vfg->previous_host, NVCV_CPU_PINNED,
+                     error, error_size) ||
+        !alloc_image(vfg, &vfg->current_host, NVCV_CPU_PINNED,
+                     error, error_size) ||
+        !alloc_image(vfg, &vfg->inputs[0], NVCV_CUDA, error, error_size) ||
+        !alloc_image(vfg, &vfg->inputs[1], NVCV_CUDA, error, error_size) ||
+        !alloc_image(vfg, &vfg->output, NVCV_CPU_PINNED,
+                     error, error_size))
+        goto fail;
+
+    status = vfg->set_cuda_stream(vfg->effect, NVVFX_CUDA_STREAM, NULL);
+    if (status != NVCV_SUCCESS) {
+        set_status_error(error, error_size, "NvVFX_SetCudaStream", status);
+        goto fail;
+    }
+
+    // SDK Core 1.3 uses feature-specific selectors. The alternates cover
+    // earlier VFG header spellings while keeping the binary SDK optional.
+    static const char *const width_selectors[] = {
+        VFG_INPUT_WIDTH, "VideoFrameGeneration.InputWidth",
+        "VideoFrameGenerationWidth", "Width", NULL,
+    };
+    static const char *const height_selectors[] = {
+        VFG_INPUT_HEIGHT, "VideoFrameGeneration.InputHeight",
+        "VideoFrameGenerationHeight", "Height", NULL,
+    };
+    static const char *const mode_selectors[] = {
+        "Mode", VFG_MODE, "VideoFrameGenerationMode", NULL,
+    };
+    if (!set_u32_candidates(vfg, width_selectors, width, error, error_size) ||
+        !set_u32_candidates(vfg, height_selectors, height, error, error_size) ||
+        !set_u32_candidates(vfg, mode_selectors, mode, error, error_size)) {
+        if (error && error_size && !error[0])
+            set_error(error, error_size, "Could not configure NVIDIA VFG");
+        goto fail;
+    }
+
+    static const char *const automatic_shot_selectors[] = {
+        VFG_AUTO_SHOT_CHANGE,
+        "VideoFrameGenerationAutomaticShotChangeDetectionEnabled",
+        "AutomaticShotChangeDetectionEnabled", NULL,
+    };
+    if (!set_u32_candidates(vfg, automatic_shot_selectors, 1,
+                            error, error_size))
+        goto fail;
+
+    status = vfg->load(vfg->effect);
+    if (status != NVCV_SUCCESS) {
+        set_status_error(error, error_size, "NvVFX_Load", status);
+        goto fail;
+    }
+
+    status = vfg->set_image(vfg->effect, NVVFX_OUTPUT_IMAGE, &vfg->output);
+    if (status != NVCV_SUCCESS) {
+        set_status_error(error, error_size, "NvVFX_SetImage(output)", status);
+        goto fail;
+    }
+
+    static const char *const multiplier_selectors[] = {
+        VFG_MULTIPLIER, "VideoFrameGenerationFrameMultiplier",
+        "FrameMultiplier", "Multiplier", NULL,
+    };
+    if (!set_u32_candidates(vfg, multiplier_selectors, vfg->multiplier,
+                            error, error_size))
+        goto fail;
+
+    return vfg;
+
+fail:
+    mpv_nvidia_vfg_destroy(&vfg);
+    return NULL;
+}
+
+bool mpv_nvidia_vfg_set_inputs(struct mpv_nvidia_vfg *vfg,
+                               const uint8_t *previous, int previous_stride,
+                               const uint8_t *current, int current_stride,
+                               bool reuse_previous,
+                               char *error, size_t error_size)
+{
+    // Adjacent pairs share an input. Keep it in its CUDA buffer and upload
+    // only the new frame into the other slot.
+    unsigned int previous_slot = reuse_previous ? vfg->current_slot : 0;
+    unsigned int current_slot = 1 - previous_slot;
+    NvCVImage *previous_gpu = &vfg->inputs[previous_slot];
+    NvCVImage *current_gpu = &vfg->inputs[current_slot];
+
+    NvCV_Status status = NVCV_SUCCESS;
+    if (!reuse_previous) {
+        copy_to_pinned(vfg, &vfg->previous_host, previous, previous_stride);
+        status = vfg->image_transfer(&vfg->previous_host, previous_gpu,
+                                     1.0f, NULL, NULL);
+    }
+    if (status == NVCV_SUCCESS) {
+        copy_to_pinned(vfg, &vfg->current_host, current, current_stride);
+        status = vfg->image_transfer(&vfg->current_host, current_gpu,
+                                     1.0f, NULL, NULL);
+    }
+    if (status != NVCV_SUCCESS) {
+        set_status_error(error, error_size, "NvCVImage_Transfer(input)", status);
+        return false;
+    }
+
+    status = vfg->set_image(vfg->effect, NVVFX_INPUT_IMAGE_0, previous_gpu);
+    if (status == NVCV_SUCCESS)
+        status = vfg->set_image(vfg->effect, NVVFX_INPUT_IMAGE_1, current_gpu);
+    if (status != NVCV_SUCCESS) {
+        set_status_error(error, error_size, "NvVFX_SetImage(input)", status);
+        return false;
+    }
+
+    vfg->current_slot = current_slot;
+    return true;
+}
+
+bool mpv_nvidia_vfg_run(struct mpv_nvidia_vfg *vfg, unsigned int frame_index,
+                        uint8_t *output, int output_stride,
+                        char *error, size_t error_size)
+{
+    static const char *const frame_index_selectors[] = {
+        VFG_FRAME_INDEX, "VideoFrameGenerationFrameIndex",
+        "FrameIndex", NULL,
+    };
+    NvCV_Status status = NVCV_ERR_SELECTOR;
+    for (int n = 0; frame_index_selectors[n]; n++) {
+        status = vfg->set_u32(vfg->effect, frame_index_selectors[n],
+                              frame_index);
+        if (status == NVCV_SUCCESS)
+            break;
+    }
+    if (status == NVCV_SUCCESS)
+    {
+        static const char *const shot_change_selectors[] = {
+            VFG_SHOT_CHANGE, "VideoFrameGenerationShotChange",
+            "ShotChange", NULL,
+        };
+        status = NVCV_ERR_SELECTOR;
+        for (int n = 0; shot_change_selectors[n]; n++) {
+            status = vfg->set_u32(vfg->effect, shot_change_selectors[n], 0);
+            if (status == NVCV_SUCCESS)
+                break;
+        }
+    }
+    if (status == NVCV_SUCCESS)
+        status = vfg->run(vfg->effect, 0);
+    if (status != NVCV_SUCCESS) {
+        set_status_error(error, error_size, "NVIDIA Video Frame Generation", status);
+        return false;
+    }
+
+    copy_from_pinned(vfg, output, output_stride);
+    return true;
+}
+
+void mpv_nvidia_vfg_destroy(struct mpv_nvidia_vfg **vfg_ptr)
+{
+    if (!vfg_ptr || !*vfg_ptr)
+        return;
+
+    struct mpv_nvidia_vfg *vfg = *vfg_ptr;
+    if (vfg->effect && vfg->destroy_effect)
+        vfg->destroy_effect(vfg->effect);
+    if (vfg->image_dealloc) {
+        vfg->image_dealloc(&vfg->previous_host);
+        vfg->image_dealloc(&vfg->current_host);
+        vfg->image_dealloc(&vfg->inputs[0]);
+        vfg->image_dealloc(&vfg->inputs[1]);
+        vfg->image_dealloc(&vfg->output);
+    }
+    if (vfg->image_dll)
+        FreeLibrary(vfg->image_dll);
+    if (vfg->vfx_dll)
+        FreeLibrary(vfg->vfx_dll);
+    free(vfg);
+    *vfg_ptr = NULL;
+}
